{
    "name": "@ts-core/language",
    "version": "3.0.38",
    "description": "TypeScript library for internationalization (i18n): multi-language support, flexible translation loaders, pluralization and runtime locale switching",
    "main": "./cjs/public-api.js",
    "module": "./esm/public-api.js",
    "exports": {
        ".": {
            "import": "./esm/public-api.js",
            "require": "./cjs/public-api.js"
        }
    },
    "scripts": {},
    "author": {
        "name": "Renat Gubaev",
        "email": "renat.gubaev@gmail.com"
    },
    "license": "ISC",
    "dependencies": {
        "@messageformat/core": "~3.4.0",
        "@ts-core/common": "~3.0.60"
    },
    "devDependencies": {
        "@types/node": "^14.14.31",
        "gulp-npm-module-publisher": "^3.0.5"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ManhattanDoctor/ts-core-language.git"
    },
    "keywords": [
        "typescript",
        "i18n",
        "internationalization",
        "localization",
        "translation",
        "language",
        "locale",
        "pluralization",
        "frontend",
        "backend"
    ],
    "bugs": {
        "url": "https://github.com/ManhattanDoctor/ts-core-language/issues"
    },
    "homepage": "https://github.com/ManhattanDoctor/ts-core-language#readme"
